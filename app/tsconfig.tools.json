{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tools.tsbuildinfo",
    "target": "es2023",
    // Las herramientas corren en Node pero importan de src/, que habla con el
    // navegador (localStorage, Blob, Worker). Hacen falta las dos librerias.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Solo las herramientas: lo que importan de src/ se comprueba igual al
  // seguir los imports, sin arrastrar la app entera ni sus tipos de Vite.
  "include": ["tools"]
}
